# 복사해서 .env로 만들고 값 채우기 (.env는 커밋 금지)

# anthropic / openai / vapi / gemini
LLM_PROVIDER=anthropic

# gemini 쓸 때만 (aistudio.google.com → Get API key, 무료)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# vapi 쓸 때만 (대시보드 프로필 → Vapi API Keys의 Private Key, Assistants에서 만든 assistant ID)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# openai 쓸 때만
OPENAI_API_KEY=
OPENAI_MODEL=

# Liner 검색 API (행사 공고 가져오기). 비우면 OPENAI_API_KEY(Liner 키)를 같이 씀
LINER_API_KEY=

# 배포 주소 (예: https://mawd-api.onrender.com) - 이미지 공개 URL 만들 때 사용
PUBLIC_BASE_URL=

# 네이버 검색광고 (서비스 운영 계정의 API 라이선스·비밀키). 광고주 CUSTOMER_ID는 앱에서 입력
# 비우면 광고 화면은 샘플 데이터(is_sample: true)로 동작
NAVER_ACCESS_LICENSE=
NAVER_SECRET_KEY=
