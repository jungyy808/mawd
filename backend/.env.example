# 복사해서 .env로 만들고 값 채우기 (.env는 커밋 금지)

# anthropic 또는 openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# openai 쓸 때만
OPENAI_API_KEY=
OPENAI_MODEL=

# 배포 주소 (예: https://mawd-api.onrender.com) - 이미지 공개 URL 만들 때 사용
PUBLIC_BASE_URL=

# 네이버 검색광고 (나중에 키워드 API 붙일 때)
NAVER_CUSTOMER_ID=
NAVER_ACCESS_LICENSE=
NAVER_SECRET_KEY=
